---
import { Image } from 'astro:assets';
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';
import logo from '@assets/logo.png';
import { getEntry } from 'astro:content';

const { data: history } = (await getEntry('history', 'history'))!;
---

<section class="mx-auto max-w-(--container-max) px-4 py-16">
  <div class="grid items-center gap-12 md:grid-cols-[0.9fr_1.1fr]">
    <div class="bg-base-200 border-line rounded-lg border p-8 shadow-card justify-self-center">
      <Image src={logo} alt="Blue Bird Theatre marquee illustration" width={220} height={330} />
    </div>
    <div>
      <SectionHeading eyebrow="Since 1981" title="The largest community theater between Columbia and Charleston" />
      <p class="font-body text-base-content mt-4 max-w-170 text-lead">{history.intro}</p>
      <Button href="/about/" variant="primary" class="mt-6">Read Our Story</Button>
    </div>
  </div>
</section>
