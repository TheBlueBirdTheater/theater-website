---
import { Image } from 'astro:assets';
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';
import theaterFront from '@assets/images/bluebird-front.png';
import { getEntry } from 'astro:content';

const { data: history } = (await getEntry('history', 'history'))!;
---

<section class="mx-auto max-w-(--container-max) px-4 py-16" data-reveal>
  <div class="grid items-center gap-12 md:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="font-heading text-primary/10 mb-3 text-display-lg leading-none font-bold" aria-hidden="true">1981</p>
      <SectionHeading eyebrow="Since 1981" title="The largest community theater between Columbia and Charleston" />
      <p class="font-body text-base-content mt-4 max-w-170 text-lead">{history.intro}</p>
      <Button href="/about/" variant="primary" class="mt-6">Read Our Story</Button>
    </div>
    <div class="border-line overflow-hidden rounded-lg border shadow-card justify-self-center">
      <Image src={theaterFront} alt="The Blue Bird Theatre marquee and storefront" format="webp" class="aspect-square w-full object-cover" />
    </div>
  </div>
</section>
