---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Badge from '@components/Badge.astro';
import ImagePlaceholder from '@components/ImagePlaceholder.astro';
import { formatEventDates, formatTime } from '@utils/dates';
import { getEventStatus } from '@utils/shows';

interface Props {
  event: CollectionEntry<'events'> | CollectionEntry<'archivedEvents'>;
  /** Renders as a plain, non-linking card — used on the season archive page where no detail page exists. */
  archived?: boolean;
  /** Renders with reduced opacity/grayscale, but still links through — used for past events on /shows/. */
  muted?: boolean;
  /** Suppresses the "Upcoming" badge (but not "Now Playing"/"Past") — used to limit the tag to the soonest items in a mixed show/event list. */
  hideUpcomingBadge?: boolean;
}

const { event, archived = false, muted = false, hideUpcomingBadge = false } = Astro.props as Props;
const { data } = event;
const Tag = archived ? 'div' : 'a';

const singleDateTimes = data.showDates.length === 1 ? data.showDates[0].times : undefined;
const status = getEventStatus(event as CollectionEntry<'events'>);
const showBadge = !archived && !(status === 'upcoming' && hideUpcomingBadge);
---

<Tag
  href={archived ? undefined : `/events/${event.id}/`}
  class:list={[
    'border-line bg-base-100 flex flex-col overflow-hidden rounded-lg border no-underline shadow-card',
    !archived && 'hover-lift',
    muted && 'opacity-60 grayscale-[0.5]',
  ]}
>
  <div class="border-line relative aspect-4/3 overflow-hidden border-b">
    {data.image ? (
      <Image
        src={data.image}
        alt={data.imageAlt ?? data.title}
        format="webp"
        class="h-full w-full object-cover"
        loading="lazy"
      />
    ) : (
      <ImagePlaceholder label={formatEventDates(data.showDates)} class="h-full w-full" />
    )}
    {showBadge && (
      <div class="absolute top-3.5 left-3.5">
        <Badge status={status} />
      </div>
    )}
    <div class="absolute top-3.5 right-3.5">
      <span class="bg-base-100/90 border-line text-base-content/70 font-body text-fineprint inline-flex items-center rounded-full border px-2.5 py-1 font-semibold tracking-[0.09em] uppercase">
        Hosted Event
      </span>
    </div>
  </div>
  <div class="flex flex-col gap-2 px-5.5 pt-5.5 pb-6">
    <h3 class="font-heading text-base-content text-card-title font-semibold tracking-[-0.01em]">{data.title}</h3>
    {data.host && <p class="font-body text-base-content/70 text-sm italic">Presented by {data.host}</p>}
    <p class="font-body text-base-content mt-1 text-sm font-medium">
      {formatEventDates(data.showDates)}
      {singleDateTimes && singleDateTimes.length > 0 && ` · ${singleDateTimes.map((t) => formatTime(t.time)).join(' & ')}`}
    </p>
  </div>
</Tag>
