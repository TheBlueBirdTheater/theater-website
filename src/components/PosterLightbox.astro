---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { faXmark } from '@fortawesome/free-solid-svg-icons';
import Icon from '@components/Icon.astro';

interface Props {
  id: string;
  src: ImageMetadata;
  alt: string;
}

const { id, src, alt } = Astro.props as Props;
---

<button type="button" data-lightbox-open={id} aria-haspopup="dialog" class="block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left">
  <slot />
</button>
<dialog id={id} data-lightbox aria-label={`${alt} — full size`}>
  <button
    type="button"
    data-lightbox-close
    aria-label="Close"
    class="btn btn-circle btn-sm bg-base-100 text-base-content border-none absolute top-3 right-3 z-10"
  >
    <Icon icon={faXmark} class="h-4 w-4" />
  </button>
  <Image src={src} alt={alt} format="webp" class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain" />
</dialog>
