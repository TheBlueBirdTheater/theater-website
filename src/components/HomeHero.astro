---
import { Image } from 'astro:assets';
import Button from '@components/Button.astro';
import MarqueeGlow from '@components/MarqueeGlow.astro';
import heroImage from '@assets/images/bluebird-side-silhouette.png';
import { getEntry } from 'astro:content';

const { data: siteCopy } = (await getEntry('siteCopy', 'siteCopy'))!;

// Chase order: down the sign's left-edge bulb trim, then across its bottom
// row — matches the physical order of the dots in the illustration itself
// (src/assets/images/bluebird-side-silhouette.png) so the lit bulb appears
// to travel around the sign's trim like a real marquee chaser light.
const chaseDots = [
  { left: 37.7, top: 53.1 },
  { left: 37.7, top: 55.6 },
  { left: 37.7, top: 58.1 },
  { left: 37.7, top: 60.6 },
  { left: 40.1, top: 61.3 },
  { left: 43.4, top: 61.3 },
  { left: 46.6, top: 61.3 },
  { left: 49.8, top: 61.3 },
  { left: 53.1, top: 61.3 },
  { left: 56.3, top: 61.3 },
  { left: 59.6, top: 61.3 },
];
const chaseStepMs = 200;
---

<section class="mx-auto grid min-h-dvh max-w-(--container-max) content-center gap-14 px-4 py-14 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-20">
  <div>
    <p class="hero-anim-1 font-body text-primary text-eyebrow font-semibold tracking-[0.09em] uppercase">{siteCopy.heroEyebrow}</p>
    <h1 class="hero-anim-2 font-heading text-base-content mt-4 text-display leading-[1.08] font-semibold tracking-[-0.01em] sm:text-display-lg">
      {siteCopy.heroTitle}
    </h1>
    <p class="hero-anim-3 font-body text-base-content mt-4 max-w-130 text-lead">
      {siteCopy.heroDescription}
    </p>
    <div class="hero-anim-4 mt-7 flex flex-wrap gap-3">
      <Button href="/shows/" variant="primary" size="lg">See What's On</Button>
      <Button href="/tickets/" variant="secondary" size="lg">Get Tickets</Button>
    </div>
  </div>
  <div class="hero-anim-poster hero-spotlight relative">
    <MarqueeGlow class="pointer-events-none absolute inset-0 z-0" />
    <div class="relative z-10 aspect-square w-full">
      {/* Warm glows meant to shine through the marquee sign's bulb trim and
          the window — positioned as percentages of the illustration's own
          box, matched by eye against the artwork. These sit BEHIND the
          image in paint order (DOM-first, and the image below is `relative`
          so both participate in the same stacking level, where DOM order
          decides who's on top) — the image's own `mix-blend-multiply` is
          what makes its white/cream areas act as see-through so these show
          through the window panes and sign dots, while its solid navy
          linework stays fully opaque on top. */}
      {chaseDots.map((dot, i) => (
        <div
          class="marquee-glow-dot"
          style={`left: ${dot.left}%; top: ${dot.top}%; animation-delay: ${i * chaseStepMs}ms;`}
          aria-hidden="true"
        />
      ))}
      <div class="marquee-glow-spot" style="left: 67.5%; top: 19%; width: 6%; height: 15%;" aria-hidden="true"></div>
      <div class="marquee-glow-spot" style="left: 73.5%; top: 19%; width: 6%; height: 15%; animation-delay: 400ms;" aria-hidden="true"></div>
      <Image
        src={heroImage}
        alt="Illustrated silhouette of the Blue Bird Theatre marquee"
        format="webp"
        class="relative mix-blend-multiply h-full w-full object-contain"
      />
    </div>
    <div class="mt-4 flex justify-center gap-3" aria-hidden="true">
      <span class="marquee-dot bg-primary h-2 w-2 rounded-full"></span>
      <span class="marquee-dot bg-primary h-2 w-2 rounded-full"></span>
      <span class="marquee-dot bg-primary h-2 w-2 rounded-full"></span>
      <span class="marquee-dot bg-primary h-2 w-2 rounded-full"></span>
      <span class="marquee-dot bg-primary h-2 w-2 rounded-full"></span>
    </div>
  </div>
</section>
