---
/**
 * Purely decorative warm ambient glow behind the homepage hero illustration —
 * evokes the marquee at dusk. Progressive enhancement only: aria-hidden,
 * carries no information, and the hero is fully legible without it (no JS,
 * no WebGL, or prefers-reduced-motion all degrade to a plain transparent
 * canvas sitting behind the real illustration).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---

<canvas data-marquee-glow aria-hidden="true" class:list={['h-full w-full', className]}></canvas>

<script>
  async function initMarqueeGlow() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-marquee-glow]');
    const container = canvas?.parentElement;
    if (!canvas || !container) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let THREE: typeof import('three');
    try {
      THREE = await import('three');
    } catch {
      return;
    }

    let renderer: InstanceType<typeof THREE.WebGLRenderer>;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    } catch {
      return;
    }

    const scene = new THREE.Scene();
    // Orthographic, not perspective: a fixed [-1, 1] x [-1, 1] view (independent
    // of aspect ratio) so hand-placed point positions map predictably onto the
    // canvas every time, instead of drifting/clustering unpredictably the way
    // a perspective camera's foreshortening does with a handful of points.
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
    camera.position.z = 5;

    function resize() {
      const { clientWidth: w, clientHeight: h } = container!;
      if (w === 0 || h === 0) return;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(w, h, false);
    }

    // Against a light cream page background, additive blending barely shows up
    // (it only really brightens dark backgrounds) — so this draws an opaque
    // warm-brass bulb core with a soft falloff, composited normally, so the
    // color itself is what reads, not an added brightness.
    function createGlowTexture() {
      const size = 128;
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const ctx = c.getContext('2d')!;
      const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      gradient.addColorStop(0, 'rgba(196, 120, 46, 0.9)');
      gradient.addColorStop(0.3, 'rgba(196, 120, 46, 0.55)');
      gradient.addColorStop(0.65, 'rgba(212, 150, 80, 0.22)');
      gradient.addColorStop(1, 'rgba(212, 150, 80, 0)');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, size, size);
      return new THREE.CanvasTexture(c);
    }

    const glowTexture = createGlowTexture();

    // Hand-placed, not random, in normalized [-1, 1] orthographic space.
    // The illustration itself has an opaque background and only fills the
    // center ~80% of this container (see HomeHero.astro), so these sit near
    // its edges/corners — straddling the boundary so roughly half of each
    // soft blur bleeds into the visible margin instead of being fully
    // covered. With an orthographic camera, three.js's point-size shader
    // ignores attenuation entirely and treats `size` as a raw pixel
    // diameter — so this needs to be large (hundreds of px), not a small
    // world-unit value.
    const spots: [number, number, number][] = [
      [0.85, 0.8, 0],
      [-0.8, 0.85, 0.1],
      [0.75, -0.85, -0.1],
      [-0.85, -0.75, 0],
    ];
    const positions = new Float32Array(spots.flat());
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const material = new THREE.PointsMaterial({
      size: 300,
      map: glowTexture,
      transparent: true,
      opacity: 0.6,
      depthWrite: false,
    });

    const points = new THREE.Points(geometry, material);
    scene.add(points);

    resize();
    renderer.render(scene, camera);

    const observer = new ResizeObserver(() => {
      resize();
      renderer.render(scene, camera);
    });
    observer.observe(container);

    // A single static frame is enough for reduced-motion users — the point
    // positions themselves already read as an ambient glow without motion.
    if (prefersReducedMotion) return;

    const start = performance.now();
    const animate = (now: number) => {
      const t = (now - start) / 1000;
      material.opacity = 0.6 + Math.sin(t * 0.6) * 0.2;
      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    };
    requestAnimationFrame(animate);
  }

  initMarqueeGlow();
</script>
