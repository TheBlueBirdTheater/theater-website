---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  onNavy?: boolean;
  level?: 'h1' | 'h2';
}

const { eyebrow, title, align = 'left', onNavy = false, level = 'h2' } = Astro.props as Props;
const Tag = level;
---

<div class:list={[align === 'center' ? 'mx-auto max-w-[640px] text-center' : 'text-left']}>
  {eyebrow && (
    <p
      class:list={[
        'font-body mb-2.5 text-eyebrow font-semibold tracking-[0.09em] uppercase',
        onNavy ? 'text-secondary-accessible' : 'text-primary',
      ]}
    >
      {eyebrow}
    </p>
  )}
  <Tag
    class:list={[
      'font-heading text-display-sm leading-[1.2] font-semibold tracking-[-0.01em]',
      onNavy ? 'text-primary-content' : 'text-base-content',
    ]}
  >
    {title}
  </Tag>
</div>
