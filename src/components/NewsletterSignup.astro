---
import LudusSubscribeWidget from '@components/LudusSubscribeWidget.astro';
---

<section class="bg-base-100" data-reveal>
  <div class="mx-auto max-w-(--container-narrow) px-6 py-16 text-center">
    <p class="font-body text-primary mb-2.5 text-eyebrow font-semibold tracking-[0.09em] uppercase">
      Stay In The Loop
    </p>
    <h2 class="font-heading text-base-content text-display-sm leading-[1.2] font-semibold tracking-[-0.01em]">
      Get show announcements in your inbox
    </h2>
    <p class="font-body text-base-content/70 mt-2">New shows, ticket on-sales, and audition dates — no spam.</p>
    <div class="mx-auto mt-6 max-w-md">
      <LudusSubscribeWidget />
    </div>
  </div>
</section>
