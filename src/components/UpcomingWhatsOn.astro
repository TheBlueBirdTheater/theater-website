---
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';
import ShowCard from '@components/ShowCard.astro';
import EventCard from '@components/EventCard.astro';
import { getUpcomingWhatsOn } from '@utils/whatsOn';

interface Props {
  eyebrow?: string;
  title?: string;
  count?: number;
  /** Skips the N soonest items — used on the homepage to avoid repeating the item already shown in FeaturedProduction. */
  skip?: number;
}

const { eyebrow = 'Coming Up', title = 'Next at the Blue Bird', count = 3, skip = 0 } = Astro.props as Props;

const whatsOn = (await getUpcomingWhatsOn(count + skip)).slice(skip);
---

<section class="mx-auto max-w-(--container-max) px-4 py-14 md:py-16">
  <SectionHeading eyebrow={eyebrow} title={title} />
  {whatsOn.length > 0 ? (
    <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {whatsOn.map((item, i) => (
        <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
          {item.kind === 'show' ? <ShowCard show={item.entry} /> : <EventCard event={item.entry} />}
        </div>
      ))}
    </div>
  ) : (
    <p class="font-body text-base-content mt-4">Our next season is coming together — check back soon!</p>
  )}
  <Button href="/shows/" variant="secondary" class="mt-8">See Everything On Stage</Button>
</section>
