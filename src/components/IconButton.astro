---
interface Props {
  /** Required — icon-only buttons must always have an accessible name. */
  'aria-label': string;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const { class: className, ...rest } = Astro.props as Props;
---

<button
  type="button"
  class:list={['btn btn-circle bg-base-100 text-base-content border-none h-11 w-11 min-h-0', className]}
  {...rest}
>
  <slot />
</button>
