---
import { Image } from "astro:assets";
import { faBars, faXmark } from "@fortawesome/free-solid-svg-icons";
import Icon from "@components/Icon.astro";
import Button from "@components/Button.astro";
import logoMark from "@assets/logo-mark.svg";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/shows/", label: "Shows" },
  { href: "/auditions/", label: "Auditions" },
  { href: "/volunteer/", label: "Volunteer" },
];

const venueInfoLinks = [
  { href: "/about/", label: "About" },
  { href: "/visit/", label: "Visit" },
  { href: "/junior-optp/", label: "Junior OPTP" },
  { href: "/rentals/", label: "Rentals" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
const isVenueInfoActive = venueInfoLinks.some((link) => isActive(link.href));
---

<header
  data-navbar
  class="bg-base-100 border-base-300 sticky top-0 z-20 border-b"
>
  <div class="navbar mx-auto max-w-(--container-max) px-4">
    <div class="navbar-start">
      <a
        href="/"
        class="flex items-center gap-2"
        aria-label="Blue Bird Theatre home"
      >
        <Image
          src={logoMark}
          alt="Blue Bird Theatre logo"
          width={40}
          height={40}
        />
        <span
          class="font-heading text-base-content text-xl font-bold tracking-[-0.01em]"
        >
          Blue Bird Theatre
        </span>
      </a>
    </div>
    <nav
      class="navbar-end hidden items-center gap-7 lg:flex"
      aria-label="Primary"
    >
      <ul class="flex items-center gap-7">
        {
          navLinks.slice(0, 3).map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "nav-link font-body text-sm font-medium",
                  isActive(link.href) ? "text-primary" : "text-base-content",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="group relative shrink-0" data-venue-info-dropdown>
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="venue-info-menu"
            class:list={[
              "nav-link font-body text-sm font-medium whitespace-nowrap",
              isVenueInfoActive ? "text-primary" : "text-base-content",
            ]}
          >
            Venue Info
          </button>
          <div
            class="invisible absolute top-full left-0 z-10 w-48 pt-2 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 [.is-open>&]:visible [.is-open>&]:opacity-100"
          >
            <ul id="venue-info-menu" class="menu bg-base-100 rounded-box p-2 shadow">
              {
                venueInfoLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive(link.href) ? "page" : undefined}
                      class:list={[
                        "font-body text-sm font-medium",
                        isActive(link.href)
                          ? "text-primary"
                          : "text-base-content",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          navLinks.slice(3).map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "nav-link font-body text-sm font-medium",
                  isActive(link.href) ? "text-primary" : "text-base-content",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/donate/" variant="secondary" size="sm">Donate</Button>
      <Button href="/tickets/" variant="primary" size="sm">Get Tickets</Button>
    </nav>
    <div class="navbar-end gap-2 lg:hidden">
      <Button href="/tickets/" variant="primary" size="sm">Tickets</Button>
      <details class="dropdown dropdown-end group">
        <summary
          class="btn btn-ghost btn-square relative z-30 list-none [&::-webkit-details-marker]:hidden"
          aria-label="Toggle menu"
        >
          <Icon icon={faBars} class="h-5 w-5 group-open:hidden" />
          <Icon icon={faXmark} class="hidden h-5 w-5 group-open:block" />
        </summary>
        <ul
          class="menu bg-base-100 fixed inset-0 z-20 mt-0 w-screen max-w-none flex-col flex-nowrap items-stretch gap-1 overflow-y-auto rounded-none p-6 pt-24 shadow-none"
          aria-label="Primary"
        >
          {
            navLinks.slice(0, 3).map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "font-body text-lg font-medium",
                    isActive(link.href) && "text-primary",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="menu-title">Venue Info</li>
          {
            venueInfoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "font-body text-lg font-medium",
                    isActive(link.href) && "text-primary",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            navLinks.slice(3).map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "font-body text-lg font-medium",
                    isActive(link.href) && "text-primary",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="border-line mt-4 border-t pt-4">
            <a href="/donate/" class="font-body text-lg font-medium">Donate</a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  function initVenueInfoDropdown() {
    const wrapper = document.querySelector<HTMLElement>('[data-venue-info-dropdown]');
    const trigger = wrapper?.querySelector<HTMLButtonElement>('button');
    if (!wrapper || !trigger) return;

    const close = () => {
      wrapper.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      wrapper.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    };

    trigger.addEventListener('click', () => {
      if (wrapper.classList.contains('is-open')) close();
      else open();
    });

    wrapper.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && wrapper.classList.contains('is-open')) {
        close();
        trigger.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!wrapper.classList.contains('is-open')) return;
      if (!wrapper.contains(event.target as Node)) close();
    });
  }

  initVenueInfoDropdown();
</script>
