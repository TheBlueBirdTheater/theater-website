---
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';
import { getEntry } from 'astro:content';

const { data: getInvolved } = (await getEntry('getInvolved', 'getInvolved'))!;
const cards = getInvolved.homeTeaserCards ?? [];
---

<section class="bg-base-200">
  <div class="mx-auto max-w-(--container-max) px-4 py-16">
    <SectionHeading eyebrow={getInvolved.homeTeaserEyebrow} title={getInvolved.homeTeaserTitle} />
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {cards.map((card, i) => (
        <div class="border-line bg-base-100 hover-lift rounded-lg border p-6 shadow-card" data-reveal data-reveal-delay={i * 80}>
          <h3 class="font-heading text-base-content text-lg font-semibold">{card.title}</h3>
          <p class="font-body text-base-content/70 mt-2 text-sm">{card.description}</p>
          <Button href={card.href} variant="secondary" size="sm" class="mt-4">{card.buttonLabel}</Button>
        </div>
      ))}
    </div>
  </div>
</section>
