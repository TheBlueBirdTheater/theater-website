---
import { toUtcInstant, type Showing } from '@utils/showings';
import { formatDate, formatTime } from '@utils/dates';
import Button from '@components/Button.astro';

interface Props {
  next: Showing | null;
  isPast: boolean;
  /** Prefixes the banner text with a show's name — used on the shows listing page, where the countdown isn't scoped to one show's own page. */
  title?: string;
  /** Renders an "Upcoming Show"/"Upcoming Event" label above the title — used alongside `title` on the shows listing page. */
  kind?: 'show' | 'event';
  /** Shows a "Get Tickets" button under the title — used on the shows listing page, where the banner isn't next to the show's own ticket button. */
  ticketUrl?: string;
  ticketPrice?: string;
}

const { next, isPast, title, kind, ticketUrl, ticketPrice } = Astro.props as Props;
const targetUtc = !isPast && next ? toUtcInstant(next) : null;

const diffMs = targetUtc ? Math.max(targetUtc.getTime() - Date.now(), 0) : 0;
const initialDays = Math.floor(diffMs / 86400000);
const initialHours = Math.floor((diffMs % 86400000) / 3600000);
const initialMinutes = Math.floor((diffMs % 3600000) / 60000);
const dayLabel = (n: number) => (n === 1 ? 'Day' : 'Days');
const hourLabel = (n: number) => (n === 1 ? 'Hr' : 'Hrs');
---

{targetUtc && next && (
  <div class="bg-primary text-primary-content">
    <div class="mx-auto flex max-w-(--container-max) flex-wrap items-center justify-between gap-3 px-4 py-4">
      <div>
        {kind && (
          <p class="font-body text-tag font-semibold tracking-[0.09em] uppercase opacity-80">
            Upcoming {kind === 'show' ? 'Show' : 'Event'}
          </p>
        )}
        <p class="font-body text-caption font-semibold">
          {title ? `${title} — ` : ''}{next.label ? `${next.label}: ` : 'Next showing: '}{formatDate(next.date)}
        </p>
        {next.time && (
          <noscript>
            <p class="font-body text-sm">{formatTime(next.time)}</p>
          </noscript>
        )}
        {ticketUrl && (
          <Button href={ticketUrl} variant="inverse" size="sm" class="mt-2">Get Tickets</Button>
        )}
        {ticketPrice && <p class="font-body mt-1 text-xs opacity-80">{ticketPrice}</p>}
      </div>
      {/* aria-hidden: the line above already states the date/showing in plain accessible text;
         this ticking numeric readout is a decorative restatement, not an update worth announcing. */}
      <div class="flex items-end gap-4" data-countdown data-countdown-target={targetUtc.toISOString()} aria-hidden="true">
        <div class="flex flex-col items-center">
          <span class="countdown font-mono text-3xl"><span data-countdown-days style={`--value:${initialDays};`}>{initialDays}</span></span>
          <span class="text-tag tracking-[0.09em] uppercase opacity-80" data-countdown-days-label>{dayLabel(initialDays)}</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="countdown font-mono text-3xl"><span data-countdown-hours style={`--value:${initialHours};`}>{initialHours}</span></span>
          <span class="text-tag tracking-[0.09em] uppercase opacity-80" data-countdown-hours-label>{hourLabel(initialHours)}</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="countdown font-mono text-3xl"><span data-countdown-minutes style={`--value:${initialMinutes};`}>{initialMinutes}</span></span>
          <span class="text-tag tracking-[0.09em] uppercase opacity-80">Min</span>
        </div>
      </div>
    </div>
  </div>
)}

<script>
  function updateCountdown(root: HTMLElement): boolean {
    const target = new Date(root.dataset.countdownTarget ?? '');
    const diffMs = target.getTime() - Date.now();
    if (diffMs <= 0) {
      root.classList.add('hidden');
      return false;
    }

    const days = Math.floor(diffMs / 86400000);
    const hours = Math.floor((diffMs % 86400000) / 3600000);
    const minutes = Math.floor((diffMs % 3600000) / 60000);

    const setUnit = (selector: string, value: number) => {
      const el = root.querySelector<HTMLElement>(selector);
      if (!el) return;
      el.textContent = String(value);
      el.style.setProperty('--value', String(value));
    };
    const setLabel = (selector: string, value: number, singular: string, plural: string) => {
      const el = root.querySelector<HTMLElement>(selector);
      if (el) el.textContent = value === 1 ? singular : plural;
    };

    setUnit('[data-countdown-days]', days);
    setUnit('[data-countdown-hours]', hours);
    setUnit('[data-countdown-minutes]', minutes);
    setLabel('[data-countdown-days-label]', days, 'Day', 'Days');
    setLabel('[data-countdown-hours-label]', hours, 'Hr', 'Hrs');
    return true;
  }

  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((root) => {
    root.classList.remove('hidden');
    if (!updateCountdown(root)) return;
    const interval = setInterval(() => {
      if (!updateCountdown(root)) clearInterval(interval);
    }, 30000);
  });
</script>
