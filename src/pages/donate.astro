---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Button from '@components/Button.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getCollection, getEntry } from 'astro:content';
import { getVenueContact } from '@data/venue';

const valueProps = await getCollection('valueProps');
const { data: donate } = (await getEntry('donate', 'donate'))!;
const { givingLevels, sponsorshipTiers, donationPlatformUrl, pageTitle, amountHelperText, nonprofitNote, cashApp, ogImage } = donate;
const contact = await getVenueContact();

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Support Us', url: '/donate/' },
]);
---

<DefaultLayout title="Support Us" description="Support the Blue Bird Theatre by donating to the Orangeburg Part-Time Players, the nonprofit that operates it." image={ogImage} imageAlt="Blue Bird Theatre, home of the Orangeburg Part-Time Players in Orangeburg, SC">
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto max-w-(--container-narrow) px-4 py-16 text-center">
    <SectionHeading eyebrow="Support Us" title={pageTitle} align="center" level="h1" />
    <div class="mt-6 grid gap-6 sm:grid-cols-3">
      {valueProps.map((vp, i) => (
        <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
          <h3 class="font-heading text-base-content font-semibold">{vp.data.title}</h3>
          <p class="font-body text-base-content/70 mt-1">{vp.data.description}</p>
        </div>
      ))}
    </div>
    <Button href={donationPlatformUrl} variant="primary" size="lg" class="mt-8">Give Now</Button>
  </div>

  <div class="mx-auto max-w-250 px-4 pb-14">
    <p class="font-body text-primary text-eyebrow font-semibold tracking-[0.09em] uppercase">Giving Levels</p>
    <p class="font-body text-base-content/70 mt-1 text-sm">{amountHelperText}</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-3" data-amount-group>
      {givingLevels.map((level, i) => {
        const isPatron = i === givingLevels.length - 1 && givingLevels.length > 1;
        return (
          <button
            type="button"
            data-amount-option
            aria-pressed="false"
            data-reveal
            data-reveal-delay={Math.min(i, 5) * 80}
            class:list={[
              'hover-lift w-full rounded-lg border-2 p-7 text-left',
              isPatron
                ? 'bg-primary text-primary-content border-primary'
                : 'border-line bg-base-100 shadow-card',
            ]}
          >
            <h3 class="font-heading font-semibold">{level.name}</h3>
            <p class:list={['font-heading mt-1 text-stat font-semibold', isPatron ? 'text-secondary-accessible' : 'text-primary']}>
              {level.amount}
            </p>
            <ul
              class:list={[
                'font-body mt-3 space-y-1 text-sm',
                isPatron ? 'text-light-blue-tint' : 'text-base-content/70',
              ]}
            >
              {level.perks.map((perk) => <li>{perk}</li>)}
            </ul>
          </button>
        );
      })}
    </div>

    <div class="mt-6">
      <button
        type="button"
        data-other-amount-toggle
        aria-expanded="false"
        aria-controls="other-amount-panel"
        class="link link-primary font-body text-sm font-semibold"
      >
        + Other Amount
      </button>
      <div class="show-expand" id="other-amount-panel">
        <div class="pt-4">
          <label for="other-amount-input" class="font-body text-base-content text-sm font-medium">Enter an amount</label>
          <input
            id="other-amount-input"
            type="number"
            min="1"
            step="1"
            placeholder="$50"
            class="input border-line text-base-content mt-1.5 block w-full max-w-40 rounded-md"
          />
        </div>
      </div>
    </div>
  </div>

  <section class="bg-base-200">
    <div class="mx-auto max-w-250 px-4 py-14">
      <p class="font-body text-primary text-eyebrow font-semibold tracking-[0.09em] uppercase">
        Business Sponsorship
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {sponsorshipTiers.map((tier, i) => (
          <div class="border-line hover-lift rounded-lg border bg-base-100 p-6.5" data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
            <h3 class="font-heading text-base-content font-semibold">{tier.name}</h3>
            <p class="font-body text-primary mt-1 text-sm">{tier.amount}</p>
            <ul class="font-body text-base-content/70 mt-3 space-y-1">
              {tier.benefits.map((benefit) => <li>{benefit}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-250 px-4 py-14 text-center">
    {nonprofitNote && <p class="font-body text-base-content/70 text-sm">{nonprofitNote}</p>}
    <p class="font-body text-base-content/70 mt-4 text-sm">Other ways to give:</p>
    <ul class="font-body text-base-content/70 mt-1 space-y-1 text-sm">
      {contact.mailingAddress && (
        <li>By mail: send a check to {contact.mailingAddress}.</li>
      )}
      {cashApp && (
        <li>
          Cash App: <a href={`https://cash.app/${cashApp}`} class="link link-primary font-medium">{cashApp}</a> (goes to our treasurer for deposit).
        </li>
      )}
    </ul>
  </div>

  <script>
    const group = document.querySelector<HTMLElement>('[data-amount-group]');
    group?.querySelectorAll<HTMLButtonElement>('[data-amount-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const alreadySelected = btn.getAttribute('aria-pressed') === 'true';
        group.querySelectorAll<HTMLButtonElement>('[data-amount-option]').forEach((other) => {
          other.setAttribute('aria-pressed', 'false');
          other.classList.remove('is-selected');
        });
        if (!alreadySelected) {
          btn.setAttribute('aria-pressed', 'true');
          btn.classList.add('is-selected');
        }
      });
    });

    const otherToggle = document.querySelector<HTMLButtonElement>('[data-other-amount-toggle]');
    otherToggle?.addEventListener('click', () => {
      const expanded = otherToggle.getAttribute('aria-expanded') === 'true';
      otherToggle.setAttribute('aria-expanded', String(!expanded));
      const panelId = otherToggle.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      panel?.classList.toggle('is-expanded', !expanded);
    });
  </script>
</DefaultLayout>
