---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import SectionHeading from '@components/SectionHeading.astro';
import InfoRow from '@components/InfoRow.astro';
import Button from '@components/Button.astro';
import VenueMap from '@components/VenueMap.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getCollection, getEntry } from 'astro:content';

const faqs = await getCollection('faqs');
const { data: contact } = (await getEntry('contact', 'contact'))!;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
]);
---

<DefaultLayout
  title="Contact"
  description="Contact info for the Blue Bird Theatre, plus answers to common questions about tickets, parking, and more."
  image={contact.ogImage}
>
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto max-w-(--container-narrow) px-4 py-16">
    <SectionHeading title="Contact" level="h1" />

    <div class="mt-8 flex flex-col gap-5">
      <InfoRow label="Phone" value={contact.phone} href={`tel:${contact.phone}`} />
      <InfoRow label="Email" value={contact.email} href={`mailto:${contact.email}`} />
      <InfoRow
        label="Address"
        value={`Blue Bird Theatre, ${contact.address.line1}, ${contact.address.city}, ${contact.address.state} ${contact.address.zip}`}
      />
      {contact.mailingAddress && <InfoRow label="Mailing Address" value={contact.mailingAddress} />}
    </div>

    <div class="mt-6 flex gap-4">
      {contact.socials.map((social) => (
        <a href={social.url} class="link link-primary">{social.platform}</a>
      ))}
    </div>

    <div class="mt-8">
      <VenueMap
        address={`Blue Bird Theatre, ${contact.address.line1}, ${contact.address.city}, ${contact.address.state} ${contact.address.zip}`}
        lat={contact.mapLat}
        lng={contact.mapLng}
      />
    </div>

    <div class="border-line bg-base-200 mt-10 rounded-lg border p-6">
      <h2 class="font-heading text-base-content text-lg font-semibold">{contact.formHeading}</h2>
      <p class="font-body text-base-content/70 mt-2 text-sm">{contact.formIntro}</p>
      <form
        name="contact-inquiry"
        method="POST"
        data-netlify="true"
        class="mt-5 flex flex-col gap-4"
      >
        <input type="hidden" name="form-name" value="contact-inquiry" />
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label for="contact-inquiry-name" class="font-body text-base-content text-sm font-medium">Name</label>
            <input
              id="contact-inquiry-name"
              type="text"
              name="name"
              required
              class="input border-line text-base-content rounded-md"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="contact-inquiry-email" class="font-body text-base-content text-sm font-medium">Email</label>
            <input
              id="contact-inquiry-email"
              type="email"
              name="email"
              required
              class="input border-line text-base-content rounded-md"
            />
          </div>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="contact-inquiry-message" class="font-body text-base-content text-sm font-medium">Message</label>
          <textarea
            id="contact-inquiry-message"
            name="message"
            rows="4"
            required
            class="textarea border-line text-base-content rounded-md"
          ></textarea>
        </div>
        <Button type="submit" variant="primary" class="self-start">Send Message</Button>
      </form>
    </div>

    <div class="mt-14 space-y-3" data-reveal>
      {faqs.map((faq) => (
        <details class="collapse-arrow border-line bg-base-100 collapse rounded-lg border">
          <summary class="font-body text-base-content collapse-title font-semibold">{faq.data.question}</summary>
          <div class="collapse-content"><p class="font-body text-base-content/70">{faq.data.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</DefaultLayout>
