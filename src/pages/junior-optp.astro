---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import SectionHeading from '@components/SectionHeading.astro';
import InfoRow from '@components/InfoRow.astro';
import Button from '@components/Button.astro';
import { Image } from 'astro:assets';
import juniorPhoto from '@assets/images/junior/junior-optp.jpg';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getEntry } from 'astro:content';
import { JR_OPTP_NAME } from '@data/venue';

const { data: extras } = (await getEntry('extras', 'extras'))!;
const { juniorOptp } = extras;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Junior OPTP', url: '/junior-optp/' },
]);
---

<DefaultLayout
  title="Junior OPTP"
  description={`${JR_OPTP_NAME} is Blue Bird Theatre's summer youth program for ${juniorOptp.ageRange.toLowerCase()} in Orangeburg, SC.`}
>
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto grid max-w-(--container-max) items-center gap-12 px-4 py-16 md:grid-cols-[1.05fr_0.95fr]">
    <div>
      <SectionHeading eyebrow={`Junior OPTP · ${juniorOptp.ageRange}`} title={juniorOptp.bannerTitle} level="h1" />
      <p class="font-body text-base-content mt-4 max-w-170 text-lead">{juniorOptp.description}</p>

      <div class="mt-6 grid gap-4.5 sm:grid-cols-2">
        <InfoRow label="Who" value={juniorOptp.ageRange} />
        <InfoRow label="Auditions" value={juniorOptp.auditionWindow} />
        <InfoRow label="Performances" value={juniorOptp.performanceWindow} />
      </div>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href="/auditions/" variant="primary">Junior OPTP Auditions</Button>
        <Button href={`mailto:${juniorOptp.contactEmail}`} variant="secondary">Ask a Question</Button>
      </div>
    </div>
    <div class="w-full overflow-hidden rounded-lg justify-self-center">
      <Image
        src={juniorPhoto}
        alt="Junior OPTP performers on stage"
        width={800}
        height={489}
        format="webp"
        class="aspect-4/3 border-line w-full border object-cover rounded-lg shadow-card"
      />
    </div>
  </div>

  <div class="mx-auto max-w-(--container-narrow) px-4 pb-16">
    <h2 class="font-body text-primary text-eyebrow font-semibold tracking-[0.09em] uppercase">Getting Involved</h2>
    <p class="font-body text-base-content mt-3">
      No experience is required to audition — Junior OPTP welcomes any young person in the community who wants to be part of a show, on stage or behind the scenes. Watch this page and the{' '}
      <a href="/auditions/" class="link link-primary">Auditions page</a> for the next casting announcement.
    </p>
    <p class="font-body text-base-content mt-3">
      Parents and other adults who'd like to help with a Junior OPTP production — building sets, costuming, chaperoning, or backstage — can find ways to pitch in on the{' '}
      <a href="/volunteer/" class="link link-primary">Volunteer page</a>.
    </p>
  </div>
</DefaultLayout>
