---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import ShowCard from '@components/ShowCard.astro';
import EventCard from '@components/EventCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
import CountdownBanner from '@components/CountdownBanner.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getCurrentSeason, getNextSeason } from '@utils/seasons';
import { getWhatsOnGroups, getNextShowingSiteWide } from '@utils/whatsOn';
import { getCollection, getEntry } from 'astro:content';

const currentSeason = getCurrentSeason();
const nextSeason = getNextSeason();

const { upcoming, past } = await getWhatsOnGroups(currentSeason);
const siteWideNext = await getNextShowingSiteWide(currentSeason);

const nextSeasonShows = (await getCollection('shows', ({ data }) => !data.draft && data.season === nextSeason))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const nextSeasonEvents = (await getCollection('events', ({ data }) => !data.draft && data.season === nextSeason))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const { data: extras } = (await getEntry('extras', 'extras'))!;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Shows', url: '/shows/' },
]);
---

<DefaultLayout
  title="Shows"
  description="See what's currently playing and what's coming up at the Blue Bird Theatre — OPTP productions and hosted events, together."
>
  <Schema schema={breadcrumbSchema} />

  {siteWideNext && (
    <CountdownBanner
      next={siteWideNext.next}
      isPast={false}
      title={siteWideNext.showTitle}
      kind={siteWideNext.kind}
      ticketUrl={siteWideNext.ticketUrl}
      ticketPrice={siteWideNext.ticketPrice}
    />
  )}

  <div id="current-season" class="mx-auto max-w-(--container-max) scroll-mt-(--nav-height) px-4 py-14">
    <SectionHeading eyebrow={`${currentSeason} Season`} title="What's On at the Blue Bird" level="h1" />
    <p class="font-body text-base-content mt-4 max-w-160">{extras.alsoAtTheBlueBird}</p>
    {upcoming.length > 0 ? (
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {upcoming.map((item, i) => (
          <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
            {item.kind === 'show' ? (
              <ShowCard show={item.entry} expandable hideUpcomingBadge={i >= 2} />
            ) : (
              <EventCard event={item.entry} hideUpcomingBadge={i >= 2} />
            )}
          </div>
        ))}
      </div>
    ) : (
      <p class="font-body text-base-content mt-4">Our next season is coming together — check back soon!</p>
    )}
  </div>

  {past.length > 0 && (
    <div id="past-this-season" class="mx-auto max-w-(--container-max) scroll-mt-(--nav-height) px-4 py-14">
      <SectionHeading eyebrow="This Season" title="Past This Season" />
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {past.map((item, i) => (
          <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
            {item.kind === 'show' ? <ShowCard show={item.entry} muted expandable /> : <EventCard event={item.entry} muted />}
          </div>
        ))}
      </div>
    </div>
  )}

  <div id="next-season" class="mx-auto max-w-(--container-max) scroll-mt-(--nav-height) px-4 py-14">
    <SectionHeading eyebrow="Looking Ahead" title={`Coming ${nextSeason} Season`} />
    {nextSeasonShows.length > 0 || nextSeasonEvents.length > 0 ? (
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {nextSeasonShows.map((show, i) => (
          <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
            <ShowCard show={show} />
          </div>
        ))}
        {nextSeasonEvents.map((event, i) => (
          <div data-reveal data-reveal-delay={Math.min(nextSeasonShows.length + i, 5) * 80}>
            <EventCard event={event} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-body text-base-content mt-4">
        Our {nextSeason} season lineup is coming soon — check back later!
      </p>
    )}
  </div>

  <section id="explore-more" class="bg-base-200 scroll-mt-(--nav-height)">
    <div class="mx-auto max-w-(--container-max) px-4 py-16">
      <p class="font-body text-base-content max-w-160">
        Curious what we've staged in seasons past?{' '}
        <a href="/shows/archive/" class="link link-primary font-semibold">See past shows</a>.
      </p>
      <p class="font-body text-base-content mt-3 max-w-160">
        Interested in renting the Blue Bird Theatre for your own production or event?{' '}
        <a href="/rentals/" class="link link-primary font-semibold">Learn more about rentals</a>.
      </p>
    </div>
  </section>
</DefaultLayout>
