---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import SectionHeading from '@components/SectionHeading.astro';
import PersonCard from '@components/PersonCard.astro';
import GalleryPreview from '@components/GalleryPreview.astro';
import StatsBand from '@components/StatsBand.astro';
import HistoryTimeline from '@components/HistoryTimeline.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getCollection, getEntry } from 'astro:content';

const historyEntry = await getEntry('history', 'history');
const history = historyEntry!.data;
const team = await getCollection('team');
const boardMembers = team.filter((person) => person.data.group === 'board');
const artisticStaff = team.filter((person) => person.data.group === 'staff');

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
]);
---

<DefaultLayout
  title="About"
  description="The story of the Orangeburg Part-Time Players, the volunteer theater company behind the Blue Bird Theatre."
  image={history.ogImage}
>
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto max-w-(--container-narrow) px-4 py-16 text-center">
    <SectionHeading eyebrow="Est. 1981" title="Orangeburg Part-Time Players" align="center" level="h1" />
    <p class="font-body text-base-content mx-auto mt-4 max-w-160 text-lead">{history.intro}</p>
  </div>

  <StatsBand />

  <div class="mx-auto max-w-(--container-narrow) px-4 pt-14 text-center">
    <SectionHeading eyebrow="The Building" title="The Blue Bird Theatre" align="center" />
  </div>
  <HistoryTimeline milestones={history.milestones} excludeYear="1981" />

  <GalleryPreview />

  {artisticStaff.length > 0 && (
    <div class="mx-auto max-w-(--container-max) px-4 py-14">
      <SectionHeading eyebrow="The People" title="Artistic Staff" />
      <div class="mt-7 flex flex-col gap-6">
        {artisticStaff.map((person, i) => (
          <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
            <PersonCard person={person} />
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="mx-auto max-w-(--container-max) px-4 pb-20">
    <p class="font-body text-primary text-eyebrow font-semibold tracking-[0.09em] uppercase">
      Board of Directors
    </p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {boardMembers.map((person, i) => (
        <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
          <PersonCard person={person} />
        </div>
      ))}
    </div>
  </div>
</DefaultLayout>
