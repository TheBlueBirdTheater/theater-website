---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import SectionHeading from '@components/SectionHeading.astro';
import DivisionAuditionPanel from '@components/DivisionAuditionPanel.astro';
import AuditionNotice from '@components/AuditionNotice.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getAuditioningNow } from '@utils/auditions';
import { getVenueContact } from '@data/venue';
import { getCollection, getEntry } from 'astro:content';

const auditioningNow = await getAuditioningNow();
const { data: extras } = (await getEntry('extras', 'extras'))!;
const { adultOptp, juniorOptp, ogImage } = extras;
const contact = await getVenueContact();
const auditionFaqs = await getCollection('faqs', ({ data }) => data.category === 'Auditions');

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Auditions', url: '/auditions/' },
]);
---

<DefaultLayout title="Auditions" description="Audition dates, requirements, and sign-up info for OPTP productions." image={ogImage}>
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto max-w-(--container-narrow) px-4 py-16 text-center">
    <SectionHeading eyebrow="Get Involved" title="Auditions" align="center" />
  </div>

  <div class="mx-auto grid max-w-250 gap-8 px-4 pb-20 md:grid-cols-2">
    <div data-reveal data-reveal-delay="0">
      <DivisionAuditionPanel
        eyebrow="Adult OPTP"
        heading="Adult OPTP"
        description={adultOptp.description}
        auditionWindow={adultOptp.auditionWindow}
        contactEmail={adultOptp.contactEmail}
      />
    </div>
    <div data-reveal data-reveal-delay="80">
      <DivisionAuditionPanel
        eyebrow="Junior OPTP"
        heading={juniorOptp.ageRange}
        description={juniorOptp.description}
        auditionWindow={juniorOptp.auditionWindow}
        performanceWindow={juniorOptp.performanceWindow}
        contactEmail={juniorOptp.contactEmail}
      />
    </div>
  </div>

  {auditioningNow.length > 0 && (
    <div class="mx-auto max-w-250 px-4 pb-20">
      <SectionHeading eyebrow="Right Now" title="Auditioning Now" />
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {auditioningNow.map((listing, i) => (
          <div data-reveal data-reveal-delay={Math.min(i, 5) * 80}>
            <AuditionNotice
              title={listing.title}
              href={listing.href}
              readMoreHref={listing.href}
              auditions={listing}
              fallbackContactEmail={contact.email}
            />
          </div>
        ))}
      </div>
    </div>
  )}

  {auditionFaqs.length > 0 && (
    <div class="mx-auto max-w-250 px-4 pb-20">
      <SectionHeading eyebrow="Good to Know" title="Audition FAQs" />
      <div class="mt-8 space-y-3" data-reveal>
        {auditionFaqs.map((faq) => (
          <details class="collapse-arrow border-line bg-base-100 collapse rounded-lg border">
            <summary class="font-body text-base-content collapse-title font-semibold">{faq.data.question}</summary>
            <div class="collapse-content"><p class="font-body text-base-content/70">{faq.data.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  )}
</DefaultLayout>
