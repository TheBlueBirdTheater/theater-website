---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import Button from '@components/Button.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { getVenueContact } from '@data/venue';
import { getEntry } from 'astro:content';

const contact = await getVenueContact();
const { data: extras } = (await getEntry('extras', 'extras'))!;
const signUpSoon = extras.auditionSignUpSoon;
const { data: siteSettings } = (await getEntry('siteSettings', 'siteSettings'))!;
const auditionInterestFormUrl = siteSettings.ludusAuditionInterestFormUrl;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Auditions', url: '/auditions/' },
  { name: 'Sign-Up Coming Soon', url: '/auditions/sign-up-soon/' },
]);
---

<DefaultLayout
  title="Sign-Up Coming Soon"
  description="Audition sign-up details for this production are still being finalized."
  noindex
>
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="font-heading text-base-content text-display-sm font-semibold">{signUpSoon?.title}</h1>
    <p class="font-body text-base-content/70 mt-4">{signUpSoon?.description}</p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      {auditionInterestFormUrl && (
        <Button href={auditionInterestFormUrl} variant="primary">Get Notified When Sign-Ups Open</Button>
      )}
      <Button href="/auditions/" variant={auditionInterestFormUrl ? 'secondary' : 'primary'}>Back to Auditions</Button>
      <Button href={`mailto:${contact.email}`} variant="secondary">Email Us</Button>
    </div>
  </div>
</DefaultLayout>
