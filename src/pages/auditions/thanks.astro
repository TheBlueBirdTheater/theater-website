---
import DefaultLayout from '@layouts/DefaultLayout.astro';
import Schema from '@components/Schema.astro';
import Button from '@components/Button.astro';
import { buildBreadcrumbSchema } from '@utils/schema';
import { LUDUS_SUBDOMAIN } from '@data/venue';

const ludusHomeUrl = `https://${LUDUS_SUBDOMAIN}.ludus.com/`;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Auditions', url: '/auditions/' },
  { name: 'Thanks for Your Interest', url: '/auditions/thanks/' },
]);
---

<DefaultLayout
  title="Thanks for Your Interest"
  description="Thanks for letting us know you're interested in auditioning with OPTP."
  noindex
>
  <Schema schema={breadcrumbSchema} />

  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="font-heading text-base-content text-display-sm font-semibold">Thanks for Your Interest!</h1>
    <p class="font-body text-base-content/70 mt-4">
      We've got your information and look forward to hearing from you. Keep an eye on your email — we'll
      reach out as soon as auditions are announced.
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <Button href={ludusHomeUrl} variant="primary">Back to Ludus</Button>
    </div>
  </div>
</DefaultLayout>
